{
  "jsc": {
    "target": "es2017",
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true,
      "nullishCoalescing": true,
      "optionalChaining": true
    },
    "transform": {
      "react": {
        "runtime": "automatic"
      },
      "optimizer": {
        "globals": {
          "vars": {
            "__DEBUG__": "false"
          }
        }
      }
    },
    "externalHelpers": false,
    "keepClassNames": true,
    "loose": false
  },
  "module": {
    "type": "es6"
  },
  "minify": false,
  "env": {
    "targets": {
      "chrome": "70",
      "firefox": "67",
      "safari": "12",
      "edge": "79"
    },
    "mode": "usage",
    "coreJs": "3",
    "include": [
      "transform-nullish-coalescing-operator",
      "transform-optional-chaining"
    ]
  }
}